# --- PostgreSQL ---
# Local (Docker : voir docker-compose.yml) :
# DATABASE_URL=postgresql://huggy:huggy_local_dev@localhost:5432/huggy
# Railway / hébergeur (souvent avec sslmode=require) :
DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- IA (priorité : Claude si ANTHROPIC_API_KEY est défini) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
# GEMINI_MODEL_GENERATE=gemini-2.0-flash
# GEMINI_MODEL_CHAT=gemini-2.0-flash

# --- App ---
PORT=8080
PUBLIC_APP_URL=https://votre-service.railway.app

# Déploiements utilisateur (fichiers statiques)
SITES_DIR=./data/sites

# Sous-domaines : hôte complet sans le sous-domaine client (ex. previews.votredomaine.com)
# Si défini, {slug}.PREVIEW_ROOT_DOMAIN sert le dossier sites/{slug}
# PREVIEW_ROOT_DOMAIN=previews.votredomaine.com

NODE_ENV=production
