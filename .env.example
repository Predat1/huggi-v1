# ╔══════════════════════════════════════════════════════════════╗
# ║  Huggy — Variables d'environnement                         ║
# ║  Copiez ce fichier vers .env.local et remplissez vos clés  ║
# ╚══════════════════════════════════════════════════════════════╝

# --- PostgreSQL (Supabase) ---
# Trouvez-la dans : Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# (Si vous utilisez le Connection Pooler et avez une erreur SSL (self-signed cert), décommentez la ligne suivante)
# DATABASE_SSL_INSECURE=true

# --- IA (priorité : Claude si ANTHROPIC_API_KEY est défini) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-4-6-sonnet-latest

GEMINI_API_KEY=
# GEMINI_MODEL_GENERATE=gemini-2.0-flash
# GEMINI_MODEL_CHAT=gemini-2.0-flash

# --- Supabase (clés publiques pour le client) ---
# Trouvez-les dans : Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...

# --- App ---
PORT=8080
PUBLIC_APP_URL=https://votre-service.railway.app

# Déploiements utilisateur (fichiers statiques)
SITES_DIR=./data/sites

# Sous-domaines (optionnel)
# PREVIEW_ROOT_DOMAIN=previews.votredomaine.com

NODE_ENV=production
