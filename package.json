{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"vite,api\" -c \"cyan,magenta\" \"vite --port=3000 --host=0.0.0.0\" \"cross-env NODE_ENV=development PORT=3001 node server/index.mjs\"",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "node server/index.mjs",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@google/genai": "^1.46.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
